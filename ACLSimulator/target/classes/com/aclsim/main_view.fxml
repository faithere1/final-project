<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.shape.SVGPath?>
<?import javafx.geometry.Insets?>

<BorderPane xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.aclsim.MainController" 
            stylesheets="@style.css"
            prefHeight="780.0" prefWidth="1200.0">
    
    <top>
        <VBox spacing="10" styleClass="header-section">
            <padding><Insets top="15" right="15" bottom="15" left="15"/></padding>
            <Label text="ACL Simulator Dashboard" style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #f1f5f9;"/>
            <HBox spacing="8" alignment="CENTER_LEFT">
                
                <!-- Group 1: CRUD Operations -->
                <Button fx:id="btnAddRule" onAction="#handleAddRule" text="Add Rule" styleClass="btn-primary">
                    <graphic>
                        <SVGPath content="M19 13h-6v6h-2v-6H5v-2h6V5h2v6h6v2z" fill="white" scaleX="0.8" scaleY="0.8"/>
                    </graphic>
                </Button>
                
                <Button onAction="#handleEditRule" text="Edit Selected" styleClass="btn-secondary">
                    <graphic>
                        <SVGPath content="M3 17.25V21h3.75L17.81 9.94l-3.75-3.75L3 17.25zM20.71 7.04c.39-.39.39-1.02 0-1.41l-2.34-2.34c-.39-.39-1.02-.39-1.41 0l-1.83 1.83 3.75 3.75 1.83-1.83z" fill="white" scaleX="0.8" scaleY="0.8"/>
                    </graphic>
                </Button>
                
                <Button fx:id="btnDeleteRule" onAction="#handleDeleteRule" text="Delete" styleClass="btn-danger">
                    <graphic>
                        <SVGPath content="M6 19c0 1.1.9 2 2 2h8c1.1 0 2-.9 2-2V7H6v12zM19 4h-3.5l-1-1h-5l-1 1H5v2h14V4z" fill="white" scaleX="0.8" scaleY="0.8"/>
                    </graphic>
                </Button>
                
                <Separator orientation="VERTICAL" />

                <!-- Group 2: File Operations -->
                <Button onAction="#handleExportCSV" text="Export CSV" styleClass="btn-secondary">
                    <graphic>
                        <SVGPath content="M19.35 10.04C18.67 6.59 15.64 4 12 4 9.11 4 6.6 5.64 5.35 8.04 2.34 8.36 0 10.91 0 14c0 3.31 2.69 6 6 6h13c2.76 0 5-2.24 5-5 0-2.64-2.05-4.78-4.65-4.96zM17 13l-5 5-5-5h3V9h4v4h3z" fill="white" scaleX="0.8" scaleY="0.8"/>
                    </graphic>
                </Button>
                
                <Button onAction="#handleImportCSV" text="Import CSV" styleClass="btn-secondary">
                    <graphic>
                        <SVGPath content="M19.35 10.04C18.67 6.59 15.64 4 12 4 9.11 4 6.6 5.64 5.35 8.04 2.34 8.36 0 10.91 0 14c0 3.31 2.69 6 6 6h13c2.76 0 5-2.24 5-5 0-2.64-2.05-4.78-4.65-4.96zM12 9l5 5h-3v4h-4v-4H7l5-5z" fill="white" scaleX="0.8" scaleY="0.8"/>
                    </graphic>
                </Button>
                
                <Separator orientation="VERTICAL" />
                
                <!-- Group 3: Analysis & Automation -->
                <Button onAction="#handleViewHistory" text="History" styleClass="btn-secondary">
                    <graphic>
                        <SVGPath content="M13 3c-4.97 0-9 4.03-9 9H1l3.89 3.89.07.14L9 12H6c0-3.87 3.13-7 7-7s7 3.13 7 7-3.13 7-7 7c-1.93 0-3.68-.79-4.94-2.06l-1.42 1.42C8.27 19.99 10.51 21 13 21c4.97 0 9-4.03 9-9s-4.03-9-9-9zm-1 5v5l4.28 2.54.72-1.21-3.5-2.08V8H12z" fill="white" scaleX="0.8" scaleY="0.8"/>
                    </graphic>
                </Button>
                
                <Button onAction="#handleGenerateCisco" text="Cisco CLI" styleClass="btn-secondary">
                    <graphic>
                        <SVGPath content="M9.4 16.6L4.8 12l4.6-4.6L8 6l-6 6 6 6 1.4-1.4zm5.2 0l4.6-4.6-4.6-4.6L16 6l6 6-6 6-1.4-1.4z" fill="white" scaleX="0.8" scaleY="0.8"/>
                    </graphic>
                </Button>
                
                <Button onAction="#handleBatchTest" text="Batch Test" styleClass="btn-secondary">
                    <graphic>
                        <SVGPath content="M4 6H2v14c0 1.1.9 2 2 2h14v-2H4V6zm16-4H8c-1.1 0-2 .9-2 2v12c0 1.1.9 2 2 2h12c1.1 0 2-.9 2-2V4c0-1.1-.9-2-2-2zm-1 9h-4v4h-2v-4H9V9h4V5h2v4h4v2z" fill="white" scaleX="0.8" scaleY="0.8"/>
                    </graphic>
                </Button>

                <Region HBox.hgrow="ALWAYS" /> 
                
                <ToggleButton fx:id="btnToggleAcademy" onAction="#handleToggleAcademy" text="Academy">
                    <graphic>
                        <SVGPath content="M12 3L1 9l11 6 9-4.91V17h2V9L12 3zM5 13.18v4L12 21l7-3.82v-4L12 17l-7-3.82z" fill="white" scaleX="0.8" scaleY="0.8"/>
                    </graphic>
                </ToggleButton>
                
                <Button onAction="#handleClearAll" text="Clear" styleClass="btn-danger">
                    <graphic>
                        <SVGPath content="M19 6.41L17.59 5 12 10.59 6.41 5 5 6.41 10.59 12 5 17.59 6.41 19 12 13.41 17.59 19 19 17.59 13.41 12z" fill="white" scaleX="0.8" scaleY="0.8"/>
                    </graphic>
                </Button>
            </HBox>
        </VBox>
    </top>

    <center>
        <VBox spacing="0">
            <padding><Insets left="15" right="15"/></padding>
            
            <!-- Rules Table with Auto-Stretch Constraint Policy -->
            <TableView fx:id="ruleTable" VBox.vgrow="ALWAYS">
                <columnResizePolicy>
                    <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                </columnResizePolicy>
                <columns>
                    <TableColumn fx:id="colPriority" text="Priority" prefWidth="70"/>
                    <TableColumn fx:id="colAction" text="Action" prefWidth="90"/>
                    <TableColumn fx:id="colProtocol" text="Protocol" prefWidth="90"/>
                    <!-- WIDENED: Source and Destination IP columns have much higher relative widths -->
                    <TableColumn fx:id="colSource" text="Source IP" prefWidth="220"/>
                    <TableColumn fx:id="colDest" text="Dest IP" prefWidth="220"/>
                    <TableColumn fx:id="colPort" text="Port/Type" prefWidth="110"/>
                </columns>
                <placeholder>
                    <Label text="No ACL rules defined. Click '+ Add Rule' to start."/>
                </placeholder>
            </TableView>

            <Pane fx:id="topoPane" prefHeight="200" minHeight="200" 
                  style="-fx-background-color: #243247; -fx-border-color: #3b4b61; -fx-border-width: 1 0 0 0;">
                <!-- Visualization drawn by MainController -->
            </Pane>
        </VBox>
    </center>

    <right>
        <VBox fx:id="academyPane" prefWidth="320" spacing="15" visible="false" managed="false">
            <padding><Insets top="20" right="15" bottom="20" left="15"/></padding>
            
            <Label text="🎓 NETWORK ACADEMY" style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #ffffff;"/>
            <Separator style="-fx-opacity: 0.3;"/>

            <VBox spacing="5">
                <Label text="Select Mission Level:" style="-fx-text-fill: #bdc3c7; -fx-font-size: 11px;"/>
                <ComboBox fx:id="comboActiveLab" maxWidth="Infinity" onAction="#handleLabSelection"/>
            </VBox>

            <VBox spacing="5" VBox.vgrow="ALWAYS">
                <Label text="Mission Orders:" style="-fx-text-fill: #bdc3c7; -fx-font-size: 11px;"/>
                <TextArea fx:id="txtLabDescription" editable="false" wrapText="true" VBox.vgrow="ALWAYS"/>
            </VBox>

            <Separator style="-fx-opacity: 0.3;"/>

            <!-- Academy Action Area -->
            <VBox spacing="10" alignment="CENTER">
                <Button text="Save Progress Report" onAction="#handleSaveProgressReport" maxWidth="Infinity" styleClass="btn-secondary"/>
                <Button text="Reset Lab Progress" onAction="#handleResetProgress" maxWidth="Infinity" styleClass="btn-danger"/>
                <Button text="Auto-Fill Test Packet" onAction="#handleAutoFillPacket" maxWidth="Infinity" styleClass="btn-secondary"/>
                <Button text="SUBMIT FOR GRADING" onAction="#handleSubmitLab" maxWidth="Infinity" prefHeight="45" styleClass="btn-success"/>
            </VBox>
        </VBox>
    </right>

    <bottom>
        <VBox spacing="15" styleClass="bottom-panel">
            <padding><Insets top="20" right="20" bottom="20" left="20"/></padding>
            <Label text="LIVE PACKET SIMULATOR" style="-fx-font-weight: bold; -fx-text-fill: #f1f5f9; -fx-letter-spacing: 1px;"/>
            
            <HBox spacing="15" alignment="CENTER_LEFT">
                <VBox spacing="5">
                    <Label text="Source IP" style="-fx-font-size: 11px; -fx-text-fill: #94a3b8;"/>
                    <TextField fx:id="txtSimSource" promptText="192.168.x.x"/>
                </VBox>
                <VBox spacing="5">
                    <Label text="Destination IP" style="-fx-font-size: 11px; -fx-text-fill: #94a3b8;"/>
                    <TextField fx:id="txtSimDest" promptText="10.0.x.x"/>
                </VBox>
                <VBox spacing="5">
                    <Label text="Protocol" style="-fx-font-size: 11px; -fx-text-fill: #94a3b8;"/>
                    <ComboBox fx:id="comboSimProtocol" prefWidth="100"/>
                </VBox>
                <VBox spacing="5">
                    <Label text="Port/Type" style="-fx-font-size: 11px; -fx-text-fill: #94a3b8;"/>
                    <TextField fx:id="txtSimPort" promptText="80" prefWidth="60"/>
                </VBox>
                <VBox alignment="BOTTOM_CENTER">
                    <Button text="RUN SIMULATION" fx:id="btnSimulate" onAction="#handleSimulate" 
                            prefHeight="35" prefWidth="160" styleClass="btn-success"/>
                </VBox>
            </HBox>
            
            <Separator style="-fx-opacity: 0.15;"/>
            
            <HBox alignment="CENTER_LEFT" spacing="10">
                <Label text="SIMULATION RESULT:" style="-fx-font-weight: bold;"/>
                <Label fx:id="lblResult" text="Waiting for packet input..." />
            </HBox>
        </VBox>
    </bottom>
</BorderPane>