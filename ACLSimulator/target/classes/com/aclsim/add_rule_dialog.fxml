<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<VBox spacing="15" xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.aclsim.AddRuleController" 
      stylesheets="@style.css" 
      prefWidth="400"> <!-- Widened slightly for better CIDR/Wildcard input visibility -->
      
    <padding><Insets top="20" right="20" bottom="20" left="20"/></padding>

    <Label text="ACL Rule Configuration" style="-fx-font-weight: bold; -fx-font-size: 18px; -fx-text-fill: #2c3e50;"/>
    <Separator />

    <GridPane hgap="12" vgap="12">
        <!-- Priority -->
        <Label text="Priority:" GridPane.rowIndex="0" GridPane.columnIndex="0" style="-fx-font-weight: bold;"/>
        <TextField fx:id="txtPriority" promptText="e.g., 10, 20..." GridPane.rowIndex="0" GridPane.columnIndex="1" maxWidth="Infinity"/>

        <!-- Action -->
        <Label text="Action:" GridPane.rowIndex="1" GridPane.columnIndex="0" style="-fx-font-weight: bold;"/>
        <ComboBox fx:id="comboAction" maxWidth="Infinity" GridPane.rowIndex="1" GridPane.columnIndex="1"/>

        <!-- Protocol -->
        <Label text="Protocol:" GridPane.rowIndex="2" GridPane.columnIndex="0" style="-fx-font-weight: bold;"/>
        <ComboBox fx:id="comboProtocol" maxWidth="Infinity" GridPane.rowIndex="2" GridPane.columnIndex="1"/>

        <!-- Source IP -->
        <Label text="Source:" GridPane.rowIndex="3" GridPane.columnIndex="0" style="-fx-font-weight: bold;"/>
        <TextField fx:id="txtSourceIp" promptText="IP, CIDR, or Wildcard" GridPane.rowIndex="3" GridPane.columnIndex="1" maxWidth="Infinity"/>

        <!-- Destination IP -->
        <Label text="Destination:" GridPane.rowIndex="4" GridPane.columnIndex="0" style="-fx-font-weight: bold;"/>
        <TextField fx:id="txtDestIp" promptText="IP, CIDR, or Wildcard" GridPane.rowIndex="4" GridPane.columnIndex="1" maxWidth="Infinity"/>

        <!-- Port / ICMP Type -->
        <Label text="Port/Type:" GridPane.rowIndex="5" GridPane.columnIndex="0" style="-fx-font-weight: bold;"/>
        <TextField fx:id="txtPort" promptText="Port, Range, or Type" GridPane.rowIndex="5" GridPane.columnIndex="1" maxWidth="Infinity"/>
        
        <columnConstraints>
            <ColumnConstraints minWidth="90" prefWidth="90" />
            <ColumnConstraints hgrow="ALWAYS" />
        </columnConstraints>
    </GridPane>

    <Region VBox.vgrow="ALWAYS" />
    <Separator />

    <HBox spacing="10" alignment="CENTER_RIGHT">
        <Button text="Cancel" onAction="#handleCancel" prefWidth="80"/>
        <Button text="Save Rule" onAction="#handleSave" prefWidth="120"
                style="-fx-background-color: #3498db; -fx-text-fill: white; -fx-font-weight: bold;"/>
    </HBox>
</VBox>