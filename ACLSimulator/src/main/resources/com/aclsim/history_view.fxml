<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<VBox spacing="10" xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml" 
      prefWidth="600" prefHeight="400">
    <padding><Insets top="15" right="15" bottom="15" left="15"/></padding>
    <Label text="Simulation History (Last 50 Tests)" style="-fx-font-weight: bold; -fx-font-size: 16px;"/>
    <TextArea fx:id="txtHistory" editable="false" VBox.vgrow="ALWAYS" style="-fx-font-family: 'Monospaced';"/>
    <Button text="Close" onAction="#handleClose" alignment="CENTER"/>
</VBox>