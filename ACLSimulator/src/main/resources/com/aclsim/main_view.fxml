<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<BorderPane xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.aclsim.MainController" 
            stylesheets="@style.css"
            prefHeight="800.0" prefWidth="1250.0"> <!-- Widened slightly for the Academy sidebar -->
    
    <top>
        <VBox spacing="10" styleClass="header-section">
            <padding><Insets top="15" right="15" bottom="15" left="15"/></padding>
            <Label text="ACL Simulator Dashboard" style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #2c3e50;"/>
            <HBox spacing="10" alignment="CENTER_LEFT">
                <!-- CRUD Operations -->
                <Button text="+ Add Rule" fx:id="btnAddRule" onAction="#handleAddRule" 
                        style="-fx-background-color: #3498db; -fx-text-fill: white;"/>
                <Button text="Edit Selected" onAction="#handleEditRule" 
                        style="-fx-background-color: #f1c40f; -fx-text-fill: white;"/>
                <Button text="Delete Selected" fx:id="btnDeleteRule" onAction="#handleDeleteRule"
                        style="-fx-background-color: #e67e22; -fx-text-fill: white;"/>
                
                <Separator orientation="VERTICAL" />

                <!-- Data Handling -->
                <Button text="Export CSV" onAction="#handleExportCSV" 
                        style="-fx-background-color: #9b59b6; -fx-text-fill: white;"/>
                <Button text="Import CSV" onAction="#handleImportCSV" 
                        style="-fx-background-color: #8e44ad; -fx-text-fill: white;"/>
                
                <Separator orientation="VERTICAL" />
                
                <!-- Analysis Tools -->
                <Button text="View History" onAction="#handleViewHistory" 
                        style="-fx-background-color: #34495e; -fx-text-fill: white;"/>
                <Button text="Cisco CLI" onAction="#handleGenerateCisco" 
                        style="-fx-background-color: #2c3e50; -fx-text-fill: white;"/>
                <Button text="Batch Test" onAction="#handleBatchTest" 
                        style="-fx-background-color: #d35400; -fx-text-fill: white;"/>

                <Region HBox.hgrow="ALWAYS" /> 
                
                <!-- NEW FOR 3.3.1: Academy Toggle Button -->
                <!-- YENİ HALİ -->
                <ToggleButton fx:id="btnToggleAcademy" text="🎓 Academy Mode" onAction="#handleToggleAcademy"
                        prefHeight="35"
                        style="-fx-background-color: #2980b9; -fx-text-fill: white; -fx-font-weight: bold; -fx-font-size: 14px; -fx-padding: 5 20 5 20; -fx-cursor: hand; -fx-background-radius: 5;"/>    
                <Button text="Clear All Rules" onAction="#handleClearAll"
                        style="-fx-background-color: #c0392b; -fx-text-fill: white;"/>
            </HBox>
        </VBox>
    </top>

    <center>
        <VBox spacing="0">
            <padding><Insets left="15" right="15"/></padding>
            
            <TableView fx:id="ruleTable" VBox.vgrow="ALWAYS">
                <columns>
                    <TableColumn fx:id="colPriority" text="Priority" prefWidth="80"/>
                    <TableColumn fx:id="colAction" text="Action" prefWidth="100"/>
                    <TableColumn fx:id="colProtocol" text="Protocol" prefWidth="100"/>
                    <TableColumn fx:id="colSource" text="Source IP" prefWidth="180"/>
                    <TableColumn fx:id="colDest" text="Dest IP" prefWidth="180"/>
                    <TableColumn fx:id="colPort" text="Port/Type" prefWidth="100"/>
                </columns>
                <placeholder>
                    <Label text="No ACL rules defined. Click '+ Add Rule' to start."/>
                </placeholder>
            </TableView>

            <Pane fx:id="topoPane" prefHeight="200" minHeight="200" 
                  style="-fx-background-color: white; -fx-border-color: #bdc3c7; -fx-border-width: 1 0 0 0;">
                <!-- Visualization drawn by MainController -->
            </Pane>
        </VBox>
    </center>

    <!-- NEW FOR 3.3: Academy Sidebar (Sliding Drawer Layout) -->
    <right>
        <VBox fx:id="academyPane" prefWidth="320" spacing="15" visible="false" managed="false"
              style="-fx-background-color: #2c3e50; -fx-border-color: #1e272e; -fx-border-width: 0 0 0 2;">
            <padding><Insets top="20" right="15" bottom="20" left="15"/></padding>
            
            <Label text="🎓 NETWORK ACADEMY" style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #ffffff;"/>
            <Separator style="-fx-opacity: 0.3;"/>

            <!-- Lab Selection Dropdown -->
            <VBox spacing="5">
                <Label text="Select Mission Level:" style="-fx-text-fill: #bdc3c7; -fx-font-size: 11px;"/>
                <ComboBox fx:id="comboActiveLab" maxWidth="Infinity" onAction="#handleLabSelection"/>
            </VBox>

            <!-- Mission Description Area -->
            <VBox spacing="5" VBox.vgrow="ALWAYS">
                <Label text="Mission Orders:" style="-fx-text-fill: #bdc3c7; -fx-font-size: 11px;"/>
                <TextArea fx:id="txtLabDescription" editable="false" wrapText="true" VBox.vgrow="ALWAYS"
                          style="-fx-control-inner-background: #34495e; -fx-text-fill: #ffffff; -fx-font-size: 12px; -fx-font-family: 'Segoe UI';"/>
            </VBox>

            <Separator style="-fx-opacity: 0.3;"/>

            <!-- Action Area -->
            <VBox spacing="10" alignment="CENTER">
                <!--3.4.4-unplanned: Save Progress Report-->
                <Button text="Save Progress Report" onAction="#handleSaveProgressReport" maxWidth="Infinity"
                        style="-fx-font-weight: bold; -fx-cursor: hand;"/>
                <!--3.4.2: Reset Progress Button-->
                <Button text="Reset Lab Progress" onAction="#handleResetProgress" maxWidth="Infinity" 
                        style="-fx-background-color: #7f8c8d; -fx-text-fill: white; -fx-font-weight: bold; -fx-cursor: hand;"/>
                <Button text="Auto-Fill Test Packet" onAction="#handleAutoFillPacket" maxWidth="Infinity" 
                        style="-fx-background-color: #34495e; -fx-text-fill: white; -fx-font-weight:bold; -fx-cursor: hand;"/>
                <Button text="SUBMIT FOR GRADING" onAction="#handleSubmitLab" maxWidth="Infinity" prefHeight="45"
                        style="-fx-background-color: #e67e22; -fx-text-fill: white; -fx-font-size: 14px; -fx-font-weight: bold; -fx-cursor: hand;"/>
            </VBox>
        </VBox>
    </right>

    <bottom>
        <VBox spacing="15" styleClass="bottom-panel">
            <padding><Insets top="20" right="20" bottom="20" left="20"/></padding>
            <Label text="LIVE PACKET SIMULATOR" style="-fx-font-weight: bold; -fx-text-fill: #34495e; -fx-letter-spacing: 1px;"/>
            
            <HBox spacing="15" alignment="CENTER_LEFT">
                <VBox spacing="5">
                    <Label text="Source IP" style="-fx-font-size: 11px;"/>
                    <TextField fx:id="txtSimSource" promptText="192.168.x.x"/>
                </VBox>
                <VBox spacing="5">
                    <Label text="Destination IP" style="-fx-font-size: 11px;"/>
                    <TextField fx:id="txtSimDest" promptText="10.0.x.x"/>
                </VBox>
                <VBox spacing="5">
                    <Label text="Protocol" style="-fx-font-size: 11px;"/>
                    <ComboBox fx:id="comboSimProtocol" prefWidth="100"/>
                </VBox>
                <VBox spacing="5">
                    <Label text="Port/Type" style="-fx-font-size: 11px;"/>
                    <TextField fx:id="txtSimPort" promptText="80" prefWidth="60"/>
                </VBox>
                <VBox alignment="BOTTOM_CENTER">
                    <Button text="RUN SIMULATION" fx:id="btnSimulate" onAction="#handleSimulate" 
                            prefHeight="35" prefWidth="160"
                            style="-fx-background-color: #27ae60; -fx-text-fill: white; -fx-font-weight: bold;"/>
                </VBox>
            </HBox>
            
            <Separator />
            
            <HBox alignment="CENTER_LEFT" spacing="10">
                <Label text="SIMULATION RESULT:" style="-fx-font-weight: bold;"/>
                <Label fx:id="lblResult" text="Waiting for packet input..." />
            </HBox>
        </VBox>
    </bottom>
</BorderPane>